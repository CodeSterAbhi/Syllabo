# Syllabo - Client Environment Configuration
# Replace these placeholder values with your Supabase Project settings.
# Find these in your Supabase Dashboard: Project Settings -> API.
#
# NOTE: The publishable/anon key is safe to use in frontend code.
# NEVER place your Supabase service_role key or database password in this file or any VITE_* variable.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key
